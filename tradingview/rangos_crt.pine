//@version=6
// Rangos CRT multitemporales · regla del trader (Bitácora de trading)
// Solo muestra los rangos PENDIENTES (todavía por completar) en la vela actual.
// Rango: la vela 2 SUPERA el máximo o el mínimo de la vela 1 y CIERRA DENTRO de su rango (cerrar justo en el extremo no cuenta).
// Entre la vela 1 y la vela 2 puede haber velas interiores. Objetivo: el otro lado de la vela 1 (cumplido cuando se SUPERA).
// Roto si una vela cerrada cierra fuera de la vela 1. Si la vela 2 supera los dos lados, no se marca.
// «*» = la vela 2 es la vela actual (aún abierta): rango en formación, puede no confirmarse al cierre.
indicator("Rangos CRT multitemporal", overlay = true, max_lines_count = 100, max_labels_count = 100, max_bars_back = 300)

i_tfs   = input.string("5,15,30,60,120,180,240,300,360,420,480,540,600,660,720,780,840,900,960,1020,1080,1140,1200,D,2D,3D,4D,5D,6D,7D,W,2W,M,2M,3M,6M,12M", "Temporalidades (separadas por comas)", tooltip = "Minutos (60 = 1H, 240 = 4H…) o D, 2D… W, 2W, M, 3M, 6M, 12M. Como máximo 40.")
i_n     = input.int(40, "Velas hacia atrás para buscar la vela 1", minval = 5, maxval = 100)
i_form  = input.bool(true, "Mostrar rangos en formación (*)")
i_lines = input.bool(true, "Dibujar líneas de los objetivos")
i_table = input.bool(true, "Mostrar tabla")
i_pos   = input.string("Arriba a la derecha", "Posición de la tabla", options = ["Arriba a la derecha", "Arriba a la izquierda", "Abajo a la derecha", "Abajo a la izquierda"])
i_cols  = input.int(6, "Columnas de la tabla", minval = 2, maxval = 10)
c_up    = input.color(color.new(#13795b, 0), "Alcista")
c_dn    = input.color(color.new(#b3261e, 0), "Bajista")
c_off   = input.color(color.new(#9aa3b2, 60), "Sin rango")

// Dentro de cada temporalidad, solo en su última vela: los 2 rangos pendientes más recientes.
crt(int n) =>
    int   d1 = 0
    float g1 = na
    int   s1 = na
    bool  f1 = false
    int   d2 = 0
    float g2 = na
    int   s2 = na
    bool  f2 = false
    if barstate.islast
        int best1 = 100000
        int bi1 = 100000
        int best2 = 100000
        int bi2 = 100000
        for i = 1 to n
            if na(high[i])
                break
            float h1 = high[i]
            float l1 = low[i]
            int j = -1
            for k = i - 1 to 0
                // la vela actual (k = 0) aún no ha cerrado: su cierre provisional decide si está «en formación»
                if not (close[k] < h1 and close[k] > l1)
                    break
                if high[k] > h1 or low[k] < l1
                    j := k
                    break
            if j >= 0
                bool sh = high[j] > h1
                bool sl = low[j] < l1
                if not (sh and sl)
                    int   dir = sh ? -1 : 1
                    float tgt = sh ? l1 : h1
                    bool alive = true
                    if j > 0
                        for m = j - 1 to 0
                            // objetivo superado (también dentro de la vela actual)
                            if (dir == 1 and high[m] > tgt) or (dir == -1 and low[m] < tgt)
                                alive := false
                                break
                            // roto: una vela CERRADA cierra fuera (la actual todavía no cuenta)
                            if m > 0 and (close[m] > h1 or close[m] < l1)
                                alive := false
                                break
                    if alive
                        if j < best1 or (j == best1 and i < bi1)
                            best2 := best1
                            bi2 := bi1
                            d2 := d1
                            g2 := g1
                            s2 := s1
                            f2 := f1
                            best1 := j
                            bi1 := i
                            d1 := dir
                            g1 := tgt
                            s1 := time[i]
                            f1 := j == 0
                        else if j < best2 or (j == best2 and i < bi2)
                            best2 := j
                            bi2 := i
                            d2 := dir
                            g2 := tgt
                            s2 := time[i]
                            f2 := j == 0
    [d1, g1, s1, f1, d2, g2, s2, f2]

// Nombre corto: 5m (minutos), 4H, 1D, 1W, 3M (meses)…
tfName(string tf) =>
    string t = str.upper(tf)
    string out = t
    if not str.contains(t, "D") and not str.contains(t, "W") and not str.contains(t, "M") and not str.contains(t, "S")
        int mins = int(str.tonumber(t))
        out := mins < 60 ? str.tostring(mins) + "m" : mins % 60 == 0 ? str.tostring(mins / 60) + "H" : str.tostring(mins) + "m"
    else
        out := (t == "D" or t == "W" or t == "M") ? "1" + t : t
    out

var array<string> tfs = str.split(str.replace_all(i_tfs, " ", ""), ",")
var int nTF = array.size(tfs)
int chartSec = timeframe.in_seconds()
float rng = ta.highest(high, 100) - ta.lowest(low, 100)

// Resultados (2 huecos por temporalidad)
array<int>   cD = array.new<int>(2 * nTF, 0)
array<float> cG = array.new<float>(2 * nTF, na)
array<int>   cS = array.new<int>(2 * nTF, na)
array<bool>  cF = array.new<bool>(2 * nTF, false)
array<bool>  sk = array.new<bool>(nTF, false)
array<string> nm = array.new<string>(nTF, "")

for [idx, tf] in tfs
    [d1, g1, s1, f1, d2, g2, s2, f2] = request.security(syminfo.tickerid, tf, crt(i_n), lookahead = barmerge.lookahead_on)
    if barstate.islast
        bool skip = timeframe.in_seconds(tf) < chartSec
        array.set(sk, idx, skip)
        array.set(nm, idx, tfName(tf))
        if not skip
            if d1 != 0 and (i_form or not f1)
                array.set(cD, idx, d1)
                array.set(cG, idx, g1)
                array.set(cS, idx, s1)
                array.set(cF, idx, f1)
            if d2 != 0 and (i_form or not f2)
                array.set(cD, nTF + idx, d2)
                array.set(cG, nTF + idx, g2)
                array.set(cS, nTF + idx, s2)
                array.set(cF, nTF + idx, f2)

// ---- Líneas (solo pendientes): una por objetivo; si coinciden varias temporalidades, una sola línea con todas ----
var array<line>  dL = array.new<line>()
var array<label> dB = array.new<label>()
if barstate.islast
    for x in dL
        line.delete(x)
    for x in dB
        label.delete(x)
    array.clear(dL)
    array.clear(dB)
    if i_lines
        array<string> gK = array.new<string>()
        array<string> gN = array.new<string>()
        array<int>    gT = array.new<int>()
        array<int>    gD = array.new<int>()
        array<float>  gP = array.new<float>()
        for idx = 0 to nTF - 1
            for w = 0 to 1
                int s = w * nTF + idx
                int d = array.get(cD, s)
                if d != 0
                    float p = math.round_to_mintick(array.get(cG, s))
                    string name = array.get(nm, idx) + (array.get(cF, s) ? "*" : "")
                    string k = str.tostring(d) + "|" + str.tostring(p)
                    int f = array.indexof(gK, k)
                    if f < 0
                        array.push(gK, k)
                        array.push(gN, name)
                        array.push(gT, array.get(cS, s))
                        array.push(gD, d)
                        array.push(gP, p)
                    else
                        array.set(gN, f, array.get(gN, f) + "-" + name)
                        array.set(gT, f, math.min(array.get(gT, f), array.get(cS, s)))
        int ng = array.size(gK)
        if ng > 0
            // ordenar por precio para separar las etiquetas que quedan muy juntas
            array<int> ord = array.sort_indices(gP, order.descending)
            float minGap = rng * 0.035
            int   barMs = chartSec * 1000
            float lastP = na
            int   shift = 0
            for q = 0 to ng - 1
                int   g = array.get(ord, q)
                float p = array.get(gP, g)
                int   d = array.get(gD, g)
                color c = d == 1 ? c_up : c_dn
                shift := (not na(lastP) and math.abs(lastP - p) < minGap) ? (shift + 1) % 4 : 0
                lastP := p
                line ln = line.new(array.get(gT, g), p, time + barMs, p, xloc = xloc.bar_time, extend = extend.right, color = c, width = 2)
                string txt = (d == 1 ? "↑ " : "↓ ") + array.get(gN, g) + " · " + str.tostring(p, format.mintick)
                label lb = label.new(time + barMs * (3 + 18 * shift), p, txt, xloc = xloc.bar_time, style = label.style_label_left, color = color.new(c, 10), textcolor = color.white, size = size.small)
                array.push(dL, ln)
                array.push(dB, lb)

// ---- Tabla: verde ↑ / rojo ↓ con rango pendiente, gris sin rango, * = en formación ----
pos = i_pos == "Arriba a la izquierda" ? position.top_left : i_pos == "Abajo a la derecha" ? position.bottom_right : i_pos == "Abajo a la izquierda" ? position.bottom_left : position.top_right
var table tb = na
if barstate.islast and i_table
    int rows = int(math.ceil(nTF / i_cols)) + 1
    if not na(tb)
        table.delete(tb)
    tb := table.new(pos, i_cols, rows, border_width = 1, border_color = color.new(color.gray, 70))
    table.cell(tb, 0, 0, "Rangos CRT pendientes (* = en formación)", text_color = chart.fg_color, text_size = size.small)
    table.merge_cells(tb, 0, 0, i_cols - 1, 0)
    for idx = 0 to nTF - 1
        int col = idx % i_cols
        int row = int(idx / i_cols) + 1
        bool skip = array.get(sk, idx)
        int d = array.get(cD, idx)
        int dd = array.get(cD, nTF + idx)
        bool form = array.get(cF, idx) or (dd != 0 and array.get(cF, nTF + idx))
        string arrow = d == 1 ? " ↑" : d == -1 ? " ↓" : ""
        if dd != 0 and dd != d
            arrow := arrow + (dd == 1 ? "↑" : "↓")
        string txt = array.get(nm, idx) + arrow + (form ? "*" : "")
        color bg = skip ? color.new(color.gray, 90) : d == 1 ? c_up : d == -1 ? c_dn : c_off
        string tip = d == 0 ? "Sin rango pendiente" : "Objetivo " + str.tostring(array.get(cG, idx), format.mintick) + (dd != 0 ? " / " + str.tostring(array.get(cG, nTF + idx), format.mintick) : "")
        table.cell(tb, col, row, skip ? array.get(nm, idx) + " ·" : txt, bgcolor = bg, text_color = (d != 0 and not skip) ? color.white : chart.fg_color, text_size = size.small, tooltip = skip ? "Temporalidad menor que la del gráfico: baja el gráfico (p. ej. a 5m) para verla" : tip)
